---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Screenshot from "../components/Screenshot.astro";
import ScoreRing from "../components/ScoreRing.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Icon from "../components/Icon.astro";
import { SUPPORT_EMAIL } from "../config";

import resultImg from "../assets/screens/result.png";
import snapImg from "../assets/screens/snap.png";
import resultTrendyImg from "../assets/screens/result-trendy.png";
import tipsImg from "../assets/screens/tips.png";
import shareImg from "../assets/screens/share.png";
import homeImg from "../assets/screens/home.png";
import storyLookImg from "../assets/photos/story-look.jpg";

const steps = [
  { n: "01", icon: "camera", title: "Snap your look", text: "Take a photo or pick one from your gallery." },
  { n: "02", icon: "gauge", title: "Get your score", text: "AI rates how on-trend your outfit is, from 0 to 100%." },
  { n: "03", icon: "sparkles", title: "Level it up", text: "Get personal tips you can apply right now." },
] as const;

const tiers = [
  { value: 32, label: "Needs Work", range: "0–39", color: "#FF5C5C" },
  { value: 45, label: "Getting There", range: "40–59", color: "#FFD23D" },
  { value: 75, label: "Trendy", range: "60–79", color: "#FF3D8A" },
  { value: 85, label: "Icon Status", range: "80–100", color: "#C6FF3D", note: "comes with confetti" },
];

const categories = [
  { label: "Color palette", value: 90 },
  { label: "Silhouette & fit", value: 80 },
  { label: "Accessories", value: 85 },
  { label: "Shoes", value: 80 },
];

const tips = [
  { title: "Add a statement bag:", text: "a contrasting accessory instantly lifts the look." },
  { title: "Soften the silhouette:", text: "try a lighter layer under the blazer." },
  { title: "Define your proportions:", text: "a belt highlights the waist and pulls the outfit together." },
];

const gallery = [
  {
    img: snapImg,
    caption: "Snap. Score. Style.",
    alt: "Trendy Look camera screen framing a full-length outfit photo, with Retake and Confirm buttons.",
  },
  {
    img: homeImg,
    caption: "Check a new look or revisit old ones.",
    alt: "Trendy Look home screen with Take a photo and From gallery buttons and a grid of recent checks.",
  },
  {
    img: resultImg,
    caption: "Score ring, 4 categories and AI tips.",
    alt: "Trendy Look result screen: 80% Icon Status score ring over an outfit photo, with category bars below.",
  },
  {
    img: tipsImg,
    caption: "Personal tips to level up your look.",
    alt: "Trendy Look result screen with category scores and four numbered AI style recommendations.",
  },
  {
    img: shareImg,
    caption: "Your result, ready for Stories.",
    alt: "Trendy Look share screen with a 9:16 story card: outfit photo, 80% Icon Status and the top tip.",
  },
];

const plans = [
  {
    name: "Free",
    price: "$0",
    period: "",
    features: ["2 outfit checks", "Full score and AI tips", "Share to Stories"],
    cta: "Start free",
    featured: false,
  },
  {
    name: "Half-year",
    price: "$29.99",
    period: "/6 months",
    features: ["Same benefits as Weekly", "Unlimited checks", "Priority AI analysis", "Early access to trends"],
    cta: "Go Half-year",
    featured: true,
  },
  {
    name: "Weekly",
    price: "$4.99",
    period: "/week",
    features: ["Unlimited checks", "Priority AI analysis", "Early access to trends"],
    cta: "Go Weekly",
    featured: false,
  },
];

const faqs = [
  {
    q: "How does it work?",
    a: "Snap your outfit, the AI looks at color, silhouette, accessories and shoes, and gives you a trend score and tips in seconds.",
  },
  { q: "Is it free?", a: "You get 2 free checks. After that, go Pro for unlimited checks." },
  { q: "Does the AI judge my body or face?", a: "Never. It only rates your outfit." },
  { q: "Can I share my results?", a: "Yes, as a 9:16 card for Stories, TikTok and Reels." },
  {
    q: "Which languages are supported?",
    a: "English, Russian, Spanish, Italian, German, French and Portuguese.",
  },
  { q: "Is it on iOS and Android?", a: "Yes, both." },
  { q: "How do I cancel my subscription?", a: "In your App Store or Google Play subscription settings." },
];

const promisePoints = [
  { icon: "shirt", label: "Clothes only" },
  { icon: "lock", label: "Your data, your call" },
  { icon: "trash", label: "Delete your account anytime" },
] as const;
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-x-clip" aria-labelledby="hero-title">
    <div class="glow glow-violet -top-40 -left-40 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="glow glow-pink top-1/3 -right-40 h-[32rem] w-[32rem] !opacity-40" aria-hidden="true"></div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pt-12 pb-20 sm:px-6 md:grid-cols-[1.15fr_0.85fr] md:pt-20 md:pb-28 lg:gap-8"
    >
      <div class="relative z-10 text-center md:text-left" data-reveal>
        <p class="eyebrow">AI stylist · iOS &amp; Android</p>
        <h1
          id="hero-title"
          class="mt-5 text-[3rem] leading-[0.98] font-extrabold sm:text-7xl lg:text-[5.5rem]"
        >
          How trendy is your <span class="text-lime">look?</span>
        </h1>
        <p class="mx-auto mt-6 max-w-lg text-lg text-muted sm:text-xl md:mx-0">
          Snap your outfit. Get a trend score, an AI style breakdown and tips in seconds. Then share it to your
          Stories.
        </p>
        <StoreButtons class="mt-8 justify-center md:justify-start" />
        <p class="mt-5 inline-flex items-center gap-2 font-mono text-xs tracking-[0.14em] text-white/80 uppercase">
          <Icon name="sparkles" size={16} class="text-lime" />
          2 free checks to start.
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-[19rem] sm:max-w-[21rem]">
        <span
          class="pointer-events-none absolute top-[38%] left-1/2 -z-0 -translate-x-1/2 -translate-y-1/2 font-display text-[11rem] leading-none font-extrabold tracking-tighter text-transparent select-none [-webkit-text-stroke:1.5px_rgb(255_255_255/0.07)] sm:text-[15rem]"
          aria-hidden="true">85%</span
        >
        <Screenshot
          src={resultImg}
          alt="Trendy Look result screen: an outfit photo with an 80% Icon Status trend score ring and category bars."
          sizes="(min-width: 640px) 336px, 304px"
          eager
          class="relative"
        />
        <div
          class="absolute -bottom-6 -left-3 w-36 rounded-[22px] border border-line-strong bg-surface/80 p-3 shadow-2xl shadow-black/60 backdrop-blur-xl sm:-left-16 sm:w-44 md:bottom-[6%] md:-left-10 md:animate-float lg:-left-28"
        >
          <ScoreRing
            id="hero"
            value={85}
            label="Icon Status"
            animate
            numberClass="text-[2rem] sm:text-[2.5rem]"
            labelClass="text-[0.55rem] sm:text-[0.6rem]"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 01 HOW IT WORKS ============ -->
  <section id="how-it-works" class="relative overflow-x-clip py-20 md:py-28" aria-labelledby="how-title">
    <div class="glow glow-magenta top-10 -left-48 h-[26rem] w-[26rem] !opacity-30" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 md:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <Screenshot
        src={snapImg}
        alt="Trendy Look camera screen framing a full-length outfit photo, with Retake and Confirm buttons."
        sizes="(min-width: 768px) 320px, 272px"
        class="order-2 mx-auto w-full max-w-[15rem] sm:max-w-[17rem] md:order-1 md:max-w-[20rem]"
      />
      <div class="order-1 md:order-2">
        <SectionHeading eyebrow="01 — How it works" id="how-title">
          Three taps to your <em>verdict</em>
        </SectionHeading>
        <ol class="mt-10 grid gap-4">
          {
            steps.map((step, i) => (
              <li
                class="card group relative flex items-start gap-5 p-5 transition-colors hover:border-line-strong sm:p-6"
                data-reveal
                style={`--reveal-delay:${i * 90}ms`}
              >
                <span class="text-gradient font-display text-4xl leading-none font-extrabold tracking-tighter sm:text-5xl">
                  {step.n}
                </span>
                <div class="flex-1">
                  <h3 class="flex items-center gap-2.5 text-xl font-bold sm:text-2xl">
                    {step.title}
                  </h3>
                  <p class="mt-1.5 text-muted">{step.text}</p>
                </div>
                <span class="hidden size-11 shrink-0 items-center justify-center rounded-full border border-line-strong text-lime sm:inline-flex">
                  <Icon name={step.icon} size={20} />
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 02 SCORE SCALE ============ -->
  <section id="score" class="relative overflow-x-clip py-20 md:py-28" aria-labelledby="score-title">
    <div class="glow glow-violet -right-40 bottom-0 h-[30rem] w-[30rem] !opacity-35" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 md:grid-cols-[1.2fr_0.8fr] lg:gap-20">
      <div>
        <SectionHeading eyebrow="02 — Score scale" id="score-title">
          Your score <em>speaks for itself</em>
          <Fragment slot="sub">Every result has a color, so you read the verdict in a split second.</Fragment>
        </SectionHeading>
        <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-4">
          {
            tiers.map((tier, i) => (
              <li
                class="card relative flex flex-col items-center overflow-hidden p-4 text-center sm:p-6"
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
              >
                {tier.note && (
                  <span class="pointer-events-none absolute inset-0" aria-hidden="true">
                    <span class="absolute top-4 left-5 h-2.5 w-1 rotate-12 rounded-sm bg-pink" />
                    <span class="absolute top-8 right-6 size-1.5 rounded-full bg-lime" />
                    <span class="absolute top-3 right-12 h-2.5 w-1 -rotate-45 rounded-sm bg-violet" />
                    <span class="absolute bottom-16 left-4 size-1.5 rounded-full bg-violet" />
                    <span class="absolute right-5 bottom-20 h-2.5 w-1 rotate-45 rounded-sm bg-lime" />
                  </span>
                )}
                <ScoreRing
                  id={`tier-${tier.value}`}
                  value={tier.value}
                  label={tier.label}
                  color={tier.color}
                  class="w-24 sm:w-32"
                  numberClass="text-2xl sm:text-[2rem]"
                  labelClass="hidden"
                />
                <p class="mt-4 font-display text-base font-bold lg:text-lg" style={`color:${tier.color}`}>
                  {tier.label}
                </p>
                <p class="mt-1 font-mono text-xs tracking-wider text-muted">{tier.range}%</p>
                {tier.note && <p class="mt-2 text-xs font-medium text-white sm:text-sm">{tier.note} 🎉</p>}
              </li>
            ))
          }
        </ul>
      </div>
      <Screenshot
        src={resultTrendyImg}
        alt="Trendy Look result screen with a 75% Trendy score ring in pink over an outfit photo."
        sizes="(min-width: 768px) 320px, 272px"
        class="mx-auto w-full max-w-[15rem] sm:max-w-[17rem] md:max-w-[20rem]"
      />
    </div>
  </section>

  <!-- ============ 03 WHAT THE AI CHECKS ============ -->
  <section id="features" class="relative overflow-x-clip py-20 md:py-28" aria-labelledby="features-title">
    <div class="glow glow-pink -top-20 -left-40 h-[28rem] w-[28rem] !opacity-30" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 md:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <Screenshot
        src={tipsImg}
        alt="Trendy Look result screen with category bars and four numbered AI style recommendations."
        sizes="(min-width: 768px) 320px, 272px"
        class="order-2 mx-auto w-full max-w-[15rem] sm:max-w-[17rem] md:order-1 md:max-w-[20rem]"
      />
      <div class="order-1 md:order-2">
        <SectionHeading eyebrow="03 — What the AI checks" id="features-title">
          A real breakdown, <em>not just a number</em>
        </SectionHeading>

        <div class="card mt-10 p-5 sm:p-7" data-reveal>
          <ul class="grid gap-5">
            {
              categories.map((cat) => (
                <li>
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="font-medium">{cat.label}</span>
                    <span class="font-mono text-sm font-semibold text-lime tabular-nums">{cat.value}%</span>
                  </div>
                  <div
                    class="mt-2 h-2 overflow-hidden rounded-full bg-white/[0.07]"
                    role="progressbar"
                    aria-label={cat.label}
                    aria-valuenow={cat.value}
                    aria-valuemin="0"
                    aria-valuemax="100"
                  >
                    <div class="bar-fill h-full rounded-full bg-lime" style={`--v:${cat.value / 100}`} />
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <ol class="mt-4 grid gap-3">
          {
            tips.map((tip, i) => (
              <li class="card flex items-start gap-4 p-4 sm:p-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-[image:var(--grad-button)] font-mono text-sm font-bold">
                  {i + 1}
                </span>
                <p class="text-muted">
                  <strong class="font-semibold text-white">{tip.title}</strong> {tip.text}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 04 MADE FOR STORIES ============ -->
  <section id="stories" class="relative overflow-x-clip py-20 md:py-28" aria-labelledby="stories-title">
    <div class="glow glow-violet top-0 -right-32 h-[30rem] w-[30rem] !opacity-40" aria-hidden="true"></div>
    <div class="glow glow-pink bottom-0 left-1/3 h-[22rem] w-[22rem] !opacity-25" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 md:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow="04 — Made for Stories" id="stories-title">
          Your result is <em>content</em>, not a report
          <Fragment slot="sub">
            Every check turns into a bold 9:16 card with your photo, score and top tip. Share it to Instagram, TikTok or
            WhatsApp in one tap and challenge your friends to beat your score.
          </Fragment>
        </SectionHeading>
        <p
          class="mt-8 inline-flex items-center gap-3 rounded-full border border-line-strong bg-white/[0.03] py-2.5 pr-5 pl-2.5 font-display text-base font-bold lg:text-lg"
          data-reveal
        >
          <span class="inline-flex size-9 items-center justify-center rounded-full bg-[image:var(--grad-button)]">
            <Icon name="share" size={18} />
          </span>
          <span>Check your look. <span class="text-lime">Tag a friend.</span></span>
        </p>
      </div>

      <div class="relative mx-auto flex w-full max-w-md items-center justify-center gap-4 sm:gap-6" data-reveal>
        <!-- Coded 9:16 story card -->
        <div
          class="relative z-10 w-[46%] -rotate-[5deg] rounded-[26px] bg-[image:var(--grad-brand)] p-[3px] shadow-[0_30px_80px_-20px_rgb(255_61_138/0.6)]"
          role="img"
          aria-label="Example 9:16 story card: outfit photo, 85% score, Icon Status, top tip, trendylook.app"
        >
          <div class="relative flex aspect-[9/16] flex-col overflow-hidden rounded-[23px] bg-bg">
            <Picture
              src={storyLookImg}
              alt=""
              formats={["avif", "webp"]}
              widths={[200, 320, 440]}
              sizes="(min-width: 640px) 200px, 160px"
              loading="lazy"
              class="absolute inset-0 h-[68%] w-full object-cover object-top"
            />
            <div class="absolute inset-x-0 top-[38%] h-[32%] bg-gradient-to-b from-transparent to-bg"></div>
            <p class="relative mt-3 text-center font-display text-[0.55rem] font-extrabold tracking-[0.2em] sm:text-[0.65rem]">
              TRENDY LOOK
            </p>
            <div class="relative mt-auto px-3 pb-3 text-center">
              <p class="text-gradient font-display text-[2.6rem] leading-none font-extrabold tracking-tighter sm:text-[3.4rem]">
                85%
              </p>
              <p class="mt-1 font-mono text-[0.5rem] font-bold tracking-[0.2em] text-lime sm:text-[0.6rem]">ICON STATUS</p>
              <div class="mt-2.5 rounded-xl border border-line-strong bg-white/[0.06] px-2 py-1.5 text-left sm:mt-3 sm:px-2.5 sm:py-2">
                <p class="font-mono text-[0.45rem] tracking-[0.16em] text-pink sm:text-[0.55rem]">TOP TIP</p>
                <p class="mt-0.5 text-[0.55rem] leading-snug font-medium sm:text-[0.68rem]">Add a statement bag</p>
              </div>
              <p class="mt-2 font-mono text-[0.45rem] tracking-[0.14em] text-muted sm:text-[0.55rem]">trendylook.app</p>
            </div>
          </div>
        </div>
        <Screenshot
          src={shareImg}
          alt="Trendy Look share screen with a ready-made 9:16 story card showing an 80% Icon Status score."
          sizes="(min-width: 640px) 200px, 160px"
          class="w-[44%] translate-y-6 rotate-[4deg]"
        />
      </div>
    </div>
  </section>

  <!-- ============ 05 INSIDE THE APP ============ -->
  <section id="inside" class="gallery-section relative overflow-x-clip py-20 md:py-28" aria-labelledby="inside-title" data-gallery-section>
    <div class="glow glow-magenta top-1/4 left-1/2 h-[26rem] w-[40rem] -translate-x-1/2 !opacity-20" aria-hidden="true"></div>
    <div class="gallery-pin" data-gallery-pin>
    <div class="relative mx-auto flex max-w-6xl items-end justify-between gap-6 px-4 sm:px-6">
      <SectionHeading eyebrow="05 — Inside the app" id="inside-title">
        Take a look <em>inside</em>
      </SectionHeading>
      <div class="hidden shrink-0 gap-2 md:flex" data-gallery-controls>
        <button
          type="button"
          class="inline-flex size-12 items-center justify-center rounded-full border border-line-strong text-white transition-colors hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-35"
          aria-label="Previous screenshot"
          aria-controls="gallery"
          data-gallery-prev
        >
          <Icon name="arrowLeft" size={20} />
        </button>
        <button
          type="button"
          class="inline-flex size-12 items-center justify-center rounded-full border border-line-strong text-white transition-colors hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-35"
          aria-label="Next screenshot"
          aria-controls="gallery"
          data-gallery-next
        >
          <Icon name="arrowRight" size={20} />
        </button>
      </div>
    </div>

    <div
      id="gallery"
      class="gallery relative mt-12 overflow-x-auto overscroll-x-contain"
      tabindex="0"
      role="region"
      aria-label="App screenshots, scroll horizontally"
      data-gallery
    >
      <ul class="flex w-max gap-5 sm:gap-8" data-gallery-track>
        {
          gallery.map((item) => (
            <li class="w-[13.5rem] shrink-0 snap-start sm:w-[16rem]" data-gallery-item>
              <figure>
                <Screenshot src={item.img} alt={item.alt} sizes="(min-width: 640px) 256px, 216px" />
                <figcaption class="mt-5 text-center text-sm font-medium text-white sm:text-base">{item.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
    </div>
  </section>

  <!-- ============ 06 OUR PROMISE ============ -->
  <section id="promise" class="relative overflow-x-clip py-20 md:py-28" aria-labelledby="promise-title">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <div
        class="relative overflow-hidden rounded-[28px] border border-line-strong bg-surface px-5 py-14 sm:px-12 md:py-20"
        data-reveal
      >
        <div class="glow glow-pink -top-32 -right-24 h-80 w-80 !opacity-45" aria-hidden="true"></div>
        <div class="glow glow-violet -bottom-32 -left-24 h-80 w-80 !opacity-45" aria-hidden="true"></div>
        <div class="relative text-center">
          <p class="eyebrow">06 — Our promise</p>
          <h2 id="promise-title" class="mx-auto mt-4 max-w-3xl text-[2.25rem] leading-[1.05] font-bold sm:text-5xl lg:text-[3.5rem]">
            Style feedback. <span class="text-lime">Zero body-shaming.</span>
          </h2>
          <p class="mx-auto mt-6 max-w-2xl text-base text-muted sm:text-lg">
            Trendy Look only looks at what you wear: clothes, colors, silhouette, accessories and shoes. Never your body,
            face or weight.
          </p>
          <ul class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
            {
              promisePoints.map((p) => (
                <li class="inline-flex items-center gap-3 rounded-full border border-line-strong bg-bg/60 py-2.5 pr-5 pl-2.5 font-medium">
                  <span class="inline-flex size-9 items-center justify-center rounded-full bg-lime/10 text-lime">
                    <Icon name={p.icon} size={18} />
                  </span>
                  {p.label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 07 PRICING ============ -->
  <section id="pricing" class="relative overflow-x-clip py-20 md:py-28" aria-labelledby="pricing-title">
    <div class="glow glow-violet top-1/3 -left-40 h-[28rem] w-[28rem] !opacity-30" aria-hidden="true"></div>
    <div class="glow glow-pink top-1/2 -right-40 h-[28rem] w-[28rem] !opacity-30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <SectionHeading eyebrow="07 — Pricing" id="pricing-title" align="center">
        Check as much as <em>you want</em>
        <Fragment slot="sub">Start free. Go Pro when you're hooked.</Fragment>
      </SectionHeading>

      <ul class="mx-auto mt-14 grid max-w-md gap-5 lg:max-w-none lg:grid-cols-3 lg:items-center lg:gap-6">
        {
          plans.map((plan, i) => (
            <li
              class:list={[
                "relative flex flex-col rounded-[24px] p-6 sm:p-7",
                plan.featured
                  ? "border-2 border-pink bg-[linear-gradient(160deg,rgb(255_61_138/0.14),rgb(123_92_255/0.1)_55%,#17171F)] shadow-[0_0_0_1px_rgb(255_61_138/0.3),0_20px_70px_-15px_rgb(255_61_138/0.55)] lg:py-10"
                  : "card",
              ]}
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
            >
              {plan.featured && (
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full whitespace-nowrap bg-lime px-3.5 py-1 font-mono text-xs font-bold tracking-[0.16em] text-bg shadow-[0_6px_24px_-6px_rgb(198_255_61/0.7)]">
                  BEST VALUE
                </span>
              )}
              <h3 class="font-mono text-sm font-semibold tracking-[0.18em] text-muted uppercase">{plan.name}</h3>
