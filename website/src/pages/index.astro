              </ul>
              <a href="#download" class:list={["btn mt-8 w-full", plan.featured ? "btn-primary" : "btn-glass"]}>
                {plan.cta}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mx-auto mt-10 max-w-xl text-center text-xs leading-relaxed text-muted sm:text-sm">
