---
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  slug: "privacy" | "terms";
}

const entry = await getEntry("legal", Astro.props.slug);
if (!entry) throw new Error(`Missing legal document: src/content/legal/${Astro.props.slug}.md`);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="relative overflow-x-clip">
    <div class="glow glow-violet -top-48 -right-40 h-[26rem] w-[26rem] !opacity-30" aria-hidden="true"></div>
    <div class="glow glow-pink -top-56 -left-48 h-[22rem] w-[22rem] !opacity-20" aria-hidden="true"></div>
    <article class="legal relative mx-auto max-w-[45rem] px-4 pt-12 pb-24 sm:px-6 md:pt-20">
      <p class="eyebrow">Legal</p>
      <Content />
    </article>
  </div>
</BaseLayout>

<style>
  .legal {
    color: rgb(255 255 255 / 0.86);
    font-size: 1rem;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  @media (min-width: 640px) {
    .legal {
      font-size: 1.0625rem;
    }
  }

  .legal :global(h1) {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    line-height: 1.05;
    font-weight: 800;
    color: #fff;
  }
  .legal :global(h2) {
    margin-top: 3rem;
    font-size: 1.625rem;
    line-height: 1.2;
    font-weight: 700;
    color: #fff;
    scroll-margin-top: 6rem;
  }
  .legal :global(h3) {
    margin-top: 2rem;
    font-size: 1.1875rem;
    line-height: 1.3;
    font-weight: 600;
    color: #fff;
    scroll-margin-top: 6rem;
  }
  .legal :global(h2 + p),
  .legal :global(h3 + p),
  .legal :global(h2 + ul),
  .legal :global(h3 + ul),
  .legal :global(h2 + table),
  .legal :global(h3 + table) {
    margin-top: 0.875rem;
  }
  .legal :global(p),
  .legal :global(ul),
  .legal :global(ol),
  .legal :global(table) {
    margin-top: 1.125rem;
  }
  .legal :global(h1 + p) {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }
  .legal :global(strong) {
    color: #fff;
    font-weight: 600;
  }
  .legal :global(em) {
    color: var(--color-muted);
  }
  .legal :global(a) {
    color: var(--color-lime);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .legal :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .legal :global(ul) {
    list-style: none;
    padding-left: 0;
  }
  .legal :global(ul > li) {
    position: relative;
    padding-left: 1.5rem;
  }
  .legal :global(ul > li)::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.72em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: var(--color-pink);
  }
  .legal :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .legal :global(ol > li)::marker {
    color: var(--color-pink);
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
  .legal :global(li + li) {
    margin-top: 0.5rem;
  }
  .legal :global(hr) {
    margin-top: 3rem;
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, rgb(255 61 138 / 0.5), rgb(123 92 255 / 0.3), transparent);
  }
  .legal :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: var(--color-surface-2);
    color: #fff;
  }
  /* Tables scroll horizontally on narrow screens instead of breaking the page */
  .legal :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.55;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 16px;
  }
  @media (min-width: 640px) {
    .legal :global(table) {
      display: table;
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      overflow: hidden;
    }
  }
  .legal :global(th),
  .legal :global(td) {
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
    min-width: 9rem;
  }
  .legal :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-pink);
    background: rgb(255 255 255 / 0.02);
  }
  .legal :global(tr:last-child td) {
    border-bottom: 0;
  }
</style>
