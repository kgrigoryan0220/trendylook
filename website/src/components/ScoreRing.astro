---
/**
 * Coded score ring. Uses the brand gradient by default, or a tier color.
 * With `animate`, the hero script counts it up from 0 (see src/scripts/hero-ring.ts).
 */
interface Props {
  value: number;
  label: string;
  color?: string; // solid tier color; omit for brand gradient
  id: string; // unique, used for the SVG gradient id
  animate?: boolean;
  class?: string;
  numberClass?: string;
  labelClass?: string;
  labelColor?: string;
}

const {
  value,
  label,
  color,
  id,
  animate = false,
  class: className,
  numberClass = "text-4xl",
  labelClass = "text-[0.6rem]",
  labelColor,
} = Astro.props;

const r = 52;
const circumference = 2 * Math.PI * r;
const offset = circumference * (1 - value / 100);
const gradId = `ring-grad-${id}`;
const stroke = color ?? `url(#${gradId})`;
---

<div
  class:list={["score-ring relative aspect-square", className]}
  role="img"
  aria-label={`Trend score ${value}%: ${label}`}
  data-score-ring={animate ? "" : undefined}
  data-value={value}
>
  <svg viewBox="0 0 120 120" class="size-full -rotate-90" aria-hidden="true">
    {
      !color && (
        <defs>
          <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FF3D8A" />
            <stop offset="1" stop-color="#7B5CFF" />
          </linearGradient>
        </defs>
      )
    }
    <circle cx="60" cy="60" r={r} fill="none" stroke="rgb(255 255 255 / 0.08)" stroke-width="8" />
    <circle
      cx="60"
      cy="60"
      r={r}
      fill="none"
      stroke={stroke}
      stroke-width="8"
      stroke-linecap="round"
      stroke-dasharray={circumference.toFixed(2)}
      stroke-dashoffset={offset.toFixed(2)}
      data-ring-progress
      style={color ? `filter: drop-shadow(0 0 6px ${color}66)` : "filter: drop-shadow(0 0 6px rgb(255 61 138 / 0.5))"}
    />
  </svg>
  <div class="absolute inset-0 flex flex-col items-center justify-center" aria-hidden="true">
    <span class:list={["font-display leading-none font-bold tracking-tight tabular-nums", numberClass]}>
      <span data-ring-number>{value}</span>%
    </span>
    <span
      class:list={["mt-1.5 font-mono font-semibold tracking-[0.18em] uppercase", labelClass]}
      style={`color: ${labelColor ?? color ?? "#C6FF3D"}`}
    >
      {label}
    </span>
  </div>
</div>
