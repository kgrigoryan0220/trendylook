---
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "../config";

interface Props {
  class?: string;
  size?: "md" | "lg";
}

const { class: className, size = "md" } = Astro.props;

const stores = [
  { id: "apple", url: APP_STORE_URL, kicker: "Download on the", label: "App Store" },
  { id: "google", url: GOOGLE_PLAY_URL, kicker: "Get it on", label: "Google Play" },
] as const;
---

<div class:list={["flex flex-wrap gap-3", className]}>
  {
    stores.map((store) => {
      const Tag = store.url ? "a" : "div";
      const linkProps = store.url
        ? { href: store.url, target: "_blank", rel: "noopener noreferrer" }
        : { role: "group" as const, "aria-label": `${store.label}, coming soon` };
      return (
        <Tag
          {...linkProps}
          class:list={[
            "store-btn btn btn-glass relative !justify-start gap-3 !rounded-2xl text-left",
            size === "lg" ? "min-h-[3.25rem] !px-4 sm:min-h-[3.75rem] sm:!px-5" : "min-h-[3.25rem] !px-4",
            !store.url && "cursor-default",
          ]}
        >
          {store.id === "apple" ? (
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
              <path d="M16.37 12.62c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.28-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.42-3.65zM14.1 5.86c.63-.77 1.06-1.84.94-2.9-.91.04-2.01.6-2.66 1.37-.58.67-1.09 1.76-.95 2.8 1.01.08 2.04-.51 2.67-1.27z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path fill="#C6FF3D" d="M3.6 2.3c-.2.2-.3.6-.3 1v17.4c0 .4.1.8.3 1l9.7-9.7L3.6 2.3z" />
              <path fill="#FF3D8A" d="m16.5 15.2-3.2-3.2 3.2-3.2 3.9 2.2c1.1.6 1.1 1.6 0 2.2l-3.9 2z" />
              <path fill="#7B5CFF" d="M16.5 15.2 13.3 12l-9.7 9.7c.4.4 1 .4 1.7 0l11.2-6.5" />
              <path fill="#FFD23D" d="M16.5 8.8 5.3 2.3c-.7-.4-1.3-.4-1.7 0l9.7 9.7 3.2-3.2z" />
            </svg>
          )}
          <span class="flex flex-col leading-tight">
            <span class="text-[0.6875rem] font-medium text-muted">{store.kicker}</span>
            <span class:list={["font-display font-semibold tracking-tight", size === "lg" ? "text-base sm:text-lg" : "text-base"]}>
              {store.label}
            </span>
          </span>
          {!store.url && (
            <span class="absolute -top-2 -right-2 rounded-full bg-lime px-2 py-0.5 font-mono text-[0.625rem] font-semibold uppercase tracking-wider text-bg">
              Coming soon
            </span>
          )}
        </Tag>
      );
    })
  }
</div>
