---
/** Eyebrow label + big heading. Wrap the key phrase in <em> inside the slot to highlight it in lime. */
interface Props {
  eyebrow: string;
  id?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, id, align = "left", class: className } = Astro.props;
---

<div class:list={[align === "center" && "mx-auto text-center", className]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2
    id={id}
    class="section-title mt-4 text-[2.25rem] leading-[1.05] font-bold sm:text-5xl lg:text-[3.5rem]"
  >
    <slot />
  </h2>
  {
    Astro.slots.has("sub") && (
      <p class:list={["mt-5 max-w-xl text-base text-muted sm:text-lg", align === "center" && "mx-auto"]}>
        <slot name="sub" />
      </p>
    )
  }
</div>

<style>
  .section-title :global(em) {
    font-style: normal;
    color: var(--color-lime);
  }
</style>
